digraph LayeredArchitecture {
  rankdir=TB;
  graph [fontname="Microsoft YaHei", fontsize=15, labelloc=t,
         label="CMS 内容管理系统 · 分层架构图",
         nodesep=0.35, ranksep=0.55, pad=0.4, compound=true, splines=polyline];
  node [fontname="Microsoft YaHei", fontsize=10.5, shape=box,
        style="rounded,filled", fillcolor="#FFFFFF", penwidth=1.2,
        margin="0.16,0.10"];
  edge [fontname="Microsoft YaHei", fontsize=9.5, arrowsize=0.7, penwidth=1.0];

  /* ============ 启动期 · 站点地图 ============ */
  subgraph cluster_bootstrap {
    label="启动期 · 站点地图（校验不过就不启动）";
    fontsize=12; color="#B09A3C"; fillcolor="#FBF6DD"; style="rounded,filled";
    node [color="#B09A3C"];
    collector [label="站点地图采集\n启动时扫描全部接口"];
    validator [label="站点地图校验\n卡片 · 权限 · 路由一致性检查"];
    collector -> validator [color="#B09A3C"];
    { rank=same; collector; validator; }
  }

  /* ============ 表现层 ============ */
  subgraph cluster_view {
    label="表现层 · Thymeleaf 模板 + 原生脚本";
    fontsize=12; color="#3B6FD4"; fillcolor="#E8F0FE"; style="rounded,filled";
    node [color="#3B6FD4"];
    view_pages [label="业务页面\n登录注册 · 工作台 · 文章 · 审核\n分类 · 用户 · 角色 · 日志 · 门户"];
    guide_ball [label="站内引导悬浮球\n把页面内容渲染成卡片"];
    { rank=same; view_pages; guide_ball; }
  }

  /* ============ 接入层 ============ */
  subgraph cluster_mvc {
    label="接入层 · Spring MVC";
    fontsize=12; color="#2F8F8F"; fillcolor="#E3F3F3"; style="rounded,filled";
    node [color="#2F8F8F"];
    auth      [label="会话认证\n校验登录状态\n未登录拦截或跳转"];
    checkroute [label="参数校验与请求路由\n校验入参并分发处理"];
    trace     [label="链路追踪\n每个请求分配追踪编号"];
    { rank=same; auth; checkroute; trace; }
  }

  /* ============ 横切关注点 · 切面 ============ */
  subgraph cluster_aop {
    label="横切关注点 · 面向切面（织入各层）";
    fontsize=12; color="#3E9C68"; fillcolor="#EAF7EF"; style="rounded,filled";
    node [color="#3E9C68"];
    gex        [label="统一异常处理\n统一返回结构与业务错误码"];
    log_aspect [label="操作日志\n关键操作留痕 · 写入前脱敏\n独立事务不丢失"];
    perm_aspect [label="权限控制\n注解式接口权限校验"];
    { rank=same; gex; log_aspect; perm_aspect; }
  }

  /* ============ 业务层 ============ */
  subgraph cluster_service {
    label="业务层 · 服务（职责单一，模块间只经统一接口通信）";
    fontsize=12; color="#7B5EB0"; fillcolor="#EFEAF7"; style="rounded,filled";
    node [color="#7B5EB0"];
    article_svc  [label="文章服务\n状态机驱动 · 乐观锁\n批量逐条容错"];
    category_svc [label="分类服务\n多级分类树\n循环与删除保护"];
    user_svc     [label="用户与角色服务\n账号 · 角色 · 权限分配"];
    log_svc      [label="日志服务\n操作日志分页查询"];
    guide_svc    [label="引导服务\n规则路由 · 模型通道"];
    { rank=same; article_svc; category_svc; user_svc; log_svc; guide_svc; }
  }

  /* ============ 持久层 ============ */
  subgraph cluster_persistence {
    label="持久层 · MyBatis-Plus";
    fontsize=12; color="#7B5EB0"; fillcolor="#F3EEFA"; style="rounded,filled";
    node [color="#7B5EB0"];
    mapping  [label="数据映射\n复杂查询与多表关联"];
    common   [label="通用能力\n分页 · 乐观锁 · 逻辑删除"];
    audit    [label="审计与防护\n自动填充审计字段\n阻止全表误操作"];
    { rank=same; mapping; common; audit; }
  }

  /* ============ 数据层 ============ */
  subgraph cluster_data {
    label="数据层";
    fontsize=12; color="#D08A3E"; fillcolor="#FDF0E2"; style="rounded,filled";
    node [color="#D08A3E"];
    db [label="MySQL 8 数据库\n用户 · 角色 · 权限 · 分类\n文章 · 日志", shape=cylinder];
  }

  /* ============ 主链：锚定垂直顺序（含不可见边） ============ */
  validator -> view_pages   [style=invis];
  view_pages -> auth         [color="#3B6FD4", label="HTTP"];
  auth -> log_aspect        [style=invis];
  log_aspect -> article_svc [style=invis];
  article_svc -> mapping    [color="#7B5EB0"];
  mapping -> db             [color="#D08A3E", label="SQL"];

  /* ============ 语义关系（虚线，不影响布局） ============ */
  guide_ball -> guide_svc [style=dashed, color="#3E9C68",
                           label="卡片 / 建议", constraint=false];
  validator -> guide_svc [style=dashed, color="#B09A3C",
                          label="站点地图快照", constraint=false];
  log_aspect -> auth [style=dashed, color="#3E9C68",
                      dir=back, constraint=false];
  perm_aspect -> article_svc [style=dashed, color="#3E9C68",
                              constraint=false];
}
